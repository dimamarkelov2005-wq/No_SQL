// ============================================================
// 00_clear_db.cypher
// ВНИМАНИЕ: удаляет ВСЕ данные в текущей базе!
// Используйте ТОЛЬКО на учебной БД.
// ============================================================

MATCH (n)
DETACH DELETE n;

// Проверка
MATCH (n)
RETURN count(n) AS remaining_nodes;
